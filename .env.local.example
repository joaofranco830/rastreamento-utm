# =============================================================================
# Modelo de variáveis de ambiente. COPIE para ".env.local" e preencha.
# NUNCA commite o .env.local (já está no .gitignore).
# =============================================================================

# --- Supabase ---
# No ambiente LOCAL (supabase start), use os valores impressos no terminal.
# A URL local padrão é http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-aqui-a-anon-key-do-supabase-start"

# Chave de serviço — SÓ NO SERVIDOR. Ignora RLS. Nunca exponha no client.
# Usada nas fases de ingestão/webhook para gravar dados.
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-a-service-role-key-do-supabase-start"

# --- Integrações (preencher nas fases futuras) ---
# Fase 2 — Hotmart Webhook 2.0
# HOTMART_HOTTOK="seu-hottok"

# Fase 4 — Meta Marketing API (System User, só no servidor)
# META_ACCESS_TOKEN="seu-token-system-user"
# META_AD_ACCOUNT_ID="act_xxxxxxxxxx"
